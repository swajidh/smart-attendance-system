# Production env for Oracle VM / Docker deployment.
# Copy to infra/docker/.env and fill in values:
#   cp infra/docker/.env.example infra/docker/.env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=smart_attendance_db
DB_PORT=5432

# ── App URLs (use your public HTTPS URL after Cloudflare / domain setup) ─────
# Example: https://attendai.yourdomain.com
ALLOWED_ORIGINS=https://attendai.yourdomain.com
FRONTEND_URL=https://attendai.yourdomain.com

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string-before-production

# ── Email (optional — password reset won't send without SMTP) ─────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com

# ── Ports exposed on the VM (80 = nginx frontend) ─────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80
