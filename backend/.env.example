# Copy to backend/.env and adjust for your environment.
# Used by local uvicorn runs; docker-compose.yml sets these via environment block.

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/smart_attendance_db

SECRET_KEY=change-me-to-a-random-64-char-string-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# SMTP (password reset, email summaries)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=true
MAIL_SSL=false

# Staff self-registration gate (POST /api/v1/auth/register/staff)
STAFF_REGISTRATION_KEY=AttendAI-Staff-2026

# Exam monitoring thresholds
EXAM_GAZE_YAW_THRESHOLD=28
EXAM_GAZE_PITCH_UP_DELTA=15
EXAM_PHONE_CONFIDENCE=0.30
EXAM_SNAPSHOT_RETENTION_DAYS=30
