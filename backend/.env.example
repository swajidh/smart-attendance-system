APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_attendance

SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated origins (no * in staging/production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ML inference service (optional until deployed)
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_SECONDS=10
